# DepthWizard environment configuration (copy to .env and fill in).

# Free key from https://portal.opentopography.org/newUser
# Required only for Stage 2 metric calibration of georeferenced GeoTIFFs.
OPENTOPO_API_KEY=

# Max number of recent job folders kept in data/web_jobs/ (default 25).
DW_MAX_JOBS=25

# --- Depth pipeline quality knobs (all optional) ---

# Depth Anything V2 backbone: small (fast, ~98MB) | base | large (best, slow on CPU).
DW_MODEL_SIZE=small

# Multi-scale tiled inference for large images: auto | on | off.
# "auto" tiles only when the longest edge is large enough that a single pass loses detail.
DW_TILED=auto

# Run CLAHE shadow enhancement on the image before inference (recovers facades in deep shade).
DW_ENHANCE_SHADOWS=false

# Detect open water (RGB heuristic) and flatten it to the local ground datum.
DW_FLATTEN_WATER=false

# Reference DEM for metric calibration: COP30 | SRTMGL1 | NASADEM | AW3D30.
# COP30 (Copernicus, TanDEM-X derived) is void-filled and is the better choice over
# Himalayan terrain, where SRTM has known gaps. See docs/ISRO_COMPATIBILITY.md.
DW_DEM_TYPE=COP30
